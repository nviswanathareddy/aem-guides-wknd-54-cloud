#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")

# Allowed types
TYPES="feature|bugfix|chore|hotfix|ci|refactor|merge"

# Get current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Extract ticket number from branch
TICKET=$(echo "$BRANCH_NAME" | grep -Eo 'WKND-[0-9]+' || echo "WKND-XXX")

# Extract branch type from branch
BRANCH_TYPE=$(echo "$BRANCH_NAME" | grep -Eo "^(${TYPES})" || echo "feature")

# Auto-fix missing space after ticket number
# Converts:
# [chore]: WKND-02add text
# to:
# [chore]: WKND-02 add text

COMMIT_MSG=$(echo "$COMMIT_MSG" | sed -E 's/(WKND-[0-9]+)([A-Za-z])/\1 \2/')

# Write corrected commit message back to file
echo "$COMMIT_MSG" > "$COMMIT_MSG_FILE"

# Remove existing prefix if present
MESSAGE=$(echo "$COMMIT_MSG" | sed -E 's/^\[[^]]+\]: WKND-[0-9]+ //')

# If message becomes empty, use original commit message
if [ -z "$MESSAGE" ]; then
  MESSAGE="$COMMIT_MSG"
fi

# Final fallback
if [ -z "$MESSAGE" ]; then
  MESSAGE="your commit message"
fi

# Strict validation pattern
# Enforces:
# [type]: WKND-123 your message

PATTERN="^\[$BRANCH_TYPE\]: $TICKET .+"

# Validate commit message
if ! echo "$COMMIT_MSG" | grep -Eq "$PATTERN"; then

  echo -e "\033[1;31m❌ ERROR: Commit message must match branch type and ticket\033[0m"
  echo -e "\033[1;31m   Current branch:\033[0m $BRANCH_NAME"

  echo -e "\033[1;32m✅ Expected format:\033[0m"
  echo -e "   [type]: WKND-XXX your commit message"

  echo -e "\033[1m   Allowed types:\033[0m feature, bugfix, chore, hotfix, ci, refactor, merge"

  echo -e "\033[1m   Example:\033[0m [$BRANCH_TYPE]: $TICKET $MESSAGE"

  exit 1
fi